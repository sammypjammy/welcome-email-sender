{
  "rewrites": [
    {
      "source": "/med-tabs/",
      "destination": "/med-tabs/index.html"
    },
    {
      "source": "/canned-remarks/",
      "destination": "/canned-remarks/index.html"
    },
    {
      "source": "/auth/callback",
      "destination": "/auth/callback.html"
    },
    {
      "source": "/settings",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/auth/callback",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
